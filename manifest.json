{
  "manifest_version": 3,
  "name": "AutoFill Pro",
  "version": "2.1.0",
  "description": "Auto-populate web forms from spreadsheet data with form scanning, template generation, and review mode",
  "homepage_url": "https://tracktechdigitals.com.ng",
  "author": "TrackTech Digitals",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/autofill.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}